DATABASE_URL=postgres://user:pass@localhost:5432/goopkos

# One key per person who runs a watcher, comma separated.
GOOPKOS_API_KEYS=heat-key-change-me

# Discord application ID, for the Activity. Public, not a secret.
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Discord Activity login, to fill in "Your name". From the Discord developer
# portal, OAuth2 > Client Secret. Secret: set it in Vercel as Sensitive.
DISCORD_CLIENT_SECRET=

# Discord /kos command: General Information > Public Key. Not a secret.
DISCORD_PUBLIC_KEY=
