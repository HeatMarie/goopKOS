# Where the addon's saved data lands. Leave unset and the watcher will
# search your drives for it on startup.
# GOOPKOS_SAVEDVARS=C:\Program Files (x86)\World of Warcraft\_forever_\WTF\Account\YOURACCT\SavedVariables\GoopKOS.lua

GOOPKOS_API_URL=http://localhost:3000
GOOPKOS_API_KEY=change-me

# How often to stat the file, in milliseconds.
GOOPKOS_POLL_MS=3000

# Site -> game: where WebData.lua is written. Normally found automatically
# next to the saved file; set it if the watcher says the folder is missing.
# GOOPKOS_ADDON_DIR=C:\Program Files (x86)\World of Warcraft\_forever_\Interface\AddOns\GoopKOS
# GOOPKOS_PULL_MS=60000
